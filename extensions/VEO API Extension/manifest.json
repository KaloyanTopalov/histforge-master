{
  "manifest_version": 3,
  "name": "VEO Flow API",
  "version": "13.1.0",
  "description": "API-based VEO Flow automation - no UI clicking, direct API calls",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "https://n8n.n8nsamerjonas.de/*",
    "https://api.baserow.io/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*"],
      "js": ["recaptcha-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://labs.google/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://labs.google/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VEO Flow API v13.1.0"
  },
  "web_accessible_resources": [
    {
      "resources": ["downloader.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
