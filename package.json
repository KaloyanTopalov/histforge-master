{
  "name": "histforge",
  "version": "0.1.0",
  "private": true,
  "description": "Unattended pipeline that turns a one-line topic into a finished historical YouTube video.",
  "scripts": {
    "ensure-native": "node scripts/ensure-native-modules.js",
    "predev": "npm run ensure-native",
    "dev": "concurrently -n web,worker -c blue,green \"next dev\" \"tsx watch src/worker/index.ts\"",
    "prebuild": "npm run ensure-native",
    "build": "next build && tsc -p tsconfig.worker.json && tsc-alias -p tsconfig.worker.json",
    "prestart": "npm run ensure-native",
    "start": "concurrently -n web,worker -c blue,green \"next start\" \"node dist/worker/index.js\"",
    "predb:init": "npm run ensure-native",
    "db:init": "tsx scripts/db-init.ts",
    "lint": "next lint",
    "pretest": "npm run ensure-native",
    "test": "vitest run",
    "pretest:watch": "npm run ensure-native",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^11.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.8.0",
    "next": "^14.2.15",
    "next-themes": "^0.4.6",
    "playwright": "^1.48.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sbd": "^1.0.19",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.13",
    "ulid": "^2.3.0",
    "undici": "^6.25.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "jsdom": "^25.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
