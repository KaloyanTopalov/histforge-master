OPENROUTER_API_KEY=
AI33_API_KEY=
GENAIPRO_API_KEY=
DATABASE_URL=./data/histforge.db
PROJECTS_DIR=./projects
WSL_DISTRO=Ubuntu

# Whisper auto-transcribe (optional — only needed if you click
# "Auto-transcribe" on the Alignment card to bypass WSL/aeneas).
#
# TWO MODES. Local takes priority when both are configured.
#
# LOCAL MODE (offline, free, no upload cap — recommended):
#   Uses whisper.cpp's `main` / `whisper-cli` binary against a ggml
#   model file. Install:
#     1. Download a release binary from
#        https://github.com/ggerganov/whisper.cpp/releases
#     2. Download a ggml model from
#        https://huggingface.co/ggerganov/whisper.cpp/tree/main
#        (`ggml-base.en.bin` is ~150 MB and good for English narration;
#        `ggml-small.en.bin` is ~500 MB and noticeably better.)
#     3. Set the two paths below.
WHISPER_LOCAL_BIN=
WHISPER_LOCAL_MODEL=
# Optional knobs for local mode:
WHISPER_LOCAL_LANG=en
WHISPER_LOCAL_THREADS=
#
# HTTP API MODE (fallback when local isn't configured):
#   Works with any OpenAI-compatible /v1/audio/transcriptions endpoint:
#     - OpenAI:   WHISPER_BASE_URL=https://api.openai.com/v1
#                 WHISPER_MODEL=whisper-1
#     - Groq:     WHISPER_BASE_URL=https://api.groq.com/openai/v1
#                 WHISPER_MODEL=whisper-large-v3
#     - self-hosted whisper-server (OpenAI-compatible): your URL + model.
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
