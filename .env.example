OPENROUTER_API_KEY=
AI33_API_KEY=
GENAIPRO_API_KEY=
DATABASE_URL=./data/histforge.db
PROJECTS_DIR=./projects
WSL_DISTRO=Ubuntu

# Whisper auto-transcribe (optional — only needed if you click
# "Auto-transcribe" on the Alignment card to bypass WSL/aeneas).
# Works with any OpenAI-compatible /v1/audio/transcriptions endpoint:
#   - OpenAI:   WHISPER_BASE_URL=https://api.openai.com/v1
#               WHISPER_MODEL=whisper-1
#   - Groq:     WHISPER_BASE_URL=https://api.groq.com/openai/v1
#               WHISPER_MODEL=whisper-large-v3
#   - self-hosted whisper-server (OpenAI-compatible): your URL + model.
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
